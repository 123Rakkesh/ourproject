<messaging:emailTemplate subject="Following Up on Small Business Teaming Opportunities"
    recipientType="Lead"
    relatedToType="User">

  <messaging:htmlEmailBody >
    <html>
      <body style="margin:0;padding:0;background-color:#f4f4f4;">

        <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
          One Algorithm LLC | Certified WOSB | IT Modernization, Staffing &amp; Delivery Support for Federal, SLED &amp; Commercial | Let us connect.
        </div>

        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f4;padding:20px 0;">
          <tr>
            <td align="center">
              <table width="600" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;border:1px solid #dddddd;">

                <tr>
                  <td align="center" style="padding:28px 32px;background-color:#1a3a5c;">
                    <p style="margin:0;font-size:22px;font-weight:bold;color:#ffffff;font-family:Arial,sans-serif;letter-spacing:1px;">One Algorithm LLC</p>
                    <p style="margin:8px 0 0;font-size:13px;color:#a8c4e0;font-family:Arial,sans-serif;">Think bigger. Build smarter. Move faster.</p>
                  </td>
                </tr>

                <tr>
                  <td style="padding:32px;font-family:Arial,sans-serif;font-size:14px;line-height:1.8;color:#333333;">

                    <p style="margin:0 0 14px;">Hello {!recipient.Company},</p>

                    <p style="margin:0 0 14px;"> I wanted to make one final follow-up regarding One Algorithm LLC and our interest in exploring potential teaming opportunities with your organization.</p>

                    <p style="margin:0 0 14px;"> If your team works with small business partners for federal, SLED, or commercial technology initiatives, we would welcome the opportunity to be considered as a resource for future pursuits.</p>

                    <p style="margin:0 0 20px;"> If now is not the right time, I completely understand. Otherwise, I would be glad to connect briefly and share more about where we may be able to support your team.</p>

                    <!-- CTA BUTTON CENTERED -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
                      <tr>
                        <td align="center">
                          <table cellpadding="0" cellspacing="0" border="0">
                            <tr>
                              <td align="center" style="border-radius:4px;background-color:#1a3a5c;">
                                <a href="https://calendly.com/onealgorithm/45min"
                                   style="display:inline-block;padding:12px 28px;font-family:Arial,sans-serif;font-size:14px;font-weight:bold;color:#ffffff;text-decoration:none;">
                                  Book a Meeting
                                </a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:0;">Thank you for your time, and I look forward to connecting.</p>

                  </td>
                </tr>

                <tr>
                  <td style="padding:0 32px;">
                    <hr style="border:none;border-top:1px solid #eeeeee;margin:0;" />
                  </td>
                </tr>

                <tr>
                  <td style="padding:14px 32px;font-family:Arial,sans-serif;font-size:10px;line-height:1.6;color:#999999;background-color:#f9f9f9;">
                    <p style="margin:0;"><strong style="color:#666666;">CONFIDENTIALITY NOTICE:</strong> The content of this email is confidential and intended for the recipient specified in message only. It is strictly forbidden to share any part of this message with any third party, without a written consent of the sender. If you received this message by mistake, please reply to this message and follow with its deletion, so that we can ensure such a mistake does not occur in the future.</p>
                  </td>
                </tr>

                <tr>
                  <td align="center" style="padding:12px 32px;font-family:Arial,sans-serif;font-size:11px;color:#888888;background-color:#f9f9f9;border-top:1px solid #eeeeee;">
                    <p style="margin:0;">One Algorithm LLC &bull; Woman-Owned Small Business<br />This email was sent by lrubino@onealgorithm.com</p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>
        </table>

      </body>
    </html>
  </messaging:htmlEmailBody>


</messaging:emailTemplate>